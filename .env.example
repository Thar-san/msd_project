# ===============================================
# Comp!lo Learn - Environment Configuration
# ===============================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/

# Authentication & Sessions
JWT_SECRET=compilo_learn_jwt_secure_key_development_2026_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=compilo_learn_cookie_secret_salt_2026

# Frontend Client URL (for CORS & Cookie Origin)
FRONTEND_URL=http://localhost:5173

# Default Initial Administrator Seed Credentials
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@compilolearn.com
ADMIN_PASSWORD=Admin@123456

# Go Compiler Sandbox Execution Configuration
GO_BINARY_PATH="C:\\Program Files\\Go\\bin\\go.exe"
GO_EXECUTION_TIMEOUT_MS=6000
GO_COMPILE_TIMEOUT_MS=60000
MAX_OUTPUT_BUFFER_BYTES=65536
